# ==============================================================================
# AllAccess Foo Fighters Ticket Monitor - Configuration Template (.env)
# ==============================================================================
# Copy this file to '.env' and populate your credentials:
#   cp .env.example .env
#
# Precedence order: CLI Arguments > Environment Variables (.env) > Built-in Defaults
# Sensitive values (tokens, webhooks, passwords) are automatically redacted in logs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Target Event & Polling Configuration
# ------------------------------------------------------------------------------
# Target event URL on AllAccess Argentina
ALLACCESS_EVENT_URL=https://www.allaccess.com.ar/event/foo-fighters

# Target section name (case-insensitive, unicode/accent-normalized matching)
# Examples: "Sivori media", "Sívori Media", "Campo Delantero", "Platea San Martin"
ALLACCESS_TARGET_SECTION=Sivori media

# Polling interval in seconds between availability checks (minimum 5s, recommended 30-60s)
POLL_INTERVAL=60

# Cooldown suppression window in seconds to prevent duplicate spam while tickets remain available
# Default: 1800 (30 minutes)
ALERT_COOLDOWN=1800

# HTTP request timeout in seconds for fetching AllAccess event pages
REQUEST_TIMEOUT=10.0

# Maximum consecutive retry attempts on network/HTTP errors before backoff
MAX_RETRIES=3

# Whether to dispatch a notification when tickets transition from AVAILABLE back to SOLD OUT
NOTIFY_ON_SOLD_OUT=false

# File path to persist alert state across daemon restarts
STATE_FILE_PATH=.monitor_state.json

# Dry-run mode: set to 'true' to test without dispatching external notifications
DRY_RUN=false

# One-shot mode: set to 'true' to run a single check and exit immediately
ONCE=false

# Application logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Optional file path for rotating logs (leave empty to log to console only)
LOG_FILE_PATH=

# ------------------------------------------------------------------------------
# 2. Telegram Bot Notification Channel
# ------------------------------------------------------------------------------
# Enable Telegram alerts (true/false)
TELEGRAM_ENABLED=false

# Telegram Bot Token (obtained from @BotFather on Telegram)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TELEGRAM_BOT_TOKEN=

# Target Telegram Chat ID (user ID, group ID, or @channel_username)
# To find your chat ID, message @userinfobot or invite your bot to a group
TELEGRAM_CHAT_ID=

# Message parse mode: HTML or Markdown (default: HTML)
TELEGRAM_PARSE_MODE=HTML

# Telegram API HTTP timeout in seconds
TELEGRAM_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 3. Discord Webhook Notification Channel
# ------------------------------------------------------------------------------
# Enable Discord alerts (true/false)
DISCORD_ENABLED=false

# Discord Incoming Webhook URL
# Generated under: Channel Settings -> Integrations -> Webhooks -> New Webhook
# Format: https://discord.com/api/webhooks/<webhook_id>/<webhook_token>
DISCORD_WEBHOOK_URL=

# Display username for the Discord webhook bot
DISCORD_USERNAME=AllAccess Ticket Monitor

# Discord API HTTP timeout in seconds
DISCORD_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 4. SMTP Email Notification Channel
# ------------------------------------------------------------------------------
# Enable Email alerts via SMTP (true/false)
EMAIL_ENABLED=false

# SMTP server hostname (e.g., smtp.gmail.com, smtp.office365.com, smtp.mailgun.org)
SMTP_HOST=

# SMTP server port (587 for STARTTLS, 465 for SSL, 25 for unencrypted relay)
SMTP_PORT=587

# Enable STARTTLS encryption (recommended for port 587)
SMTP_USE_TLS=true

# Enable direct SSL/TLS encryption (recommended for port 465)
SMTP_USE_SSL=false

# SMTP authentication username (usually your full email address)
SMTP_USERNAME=

# SMTP authentication password (for Gmail, generate an "App Password" with 2FA)
SMTP_PASSWORD=

# Sender email address (defaults to SMTP_USERNAME if blank)
EMAIL_FROM=

# Recipient email address(es) - separate multiple recipients with commas
EMAIL_TO=recipient1@example.com,recipient2@example.com

# SMTP connection and socket timeout in seconds
EMAIL_TIMEOUT_SECONDS=15.0
